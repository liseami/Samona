{
  "name": "samo-agent",
  "version": "0.1.0",
  "private": true,
  "description": "samo-browser — the CLI that lets any AI agent drive Samo through the ego-browser runtime",
  "type": "module",
  "bin": {
    "samo-browser": "./dist/cli.js"
  },
  "exports": {
    "./protocol": {
      "types": "./src/protocol.ts",
      "default": "./dist/protocol.js"
    }
  },
  "scripts": {
    "build": "node scripts/sync-workspace.mjs && tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "postinstall": "node scripts/sync-workspace.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "ego-browser-v2": "^0.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.19.0"
  },
  "files": [
    "dist",
    "workspace",
    "scripts"
  ]
}
