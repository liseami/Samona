# [INPUT]: 依赖 //ui/webui/resources/tools/generate_grd.gni、//tools/grit/grit_rule.gni；webui/dist/manifest.txt（samo-app `bun run build:webui` 产出）
# [OUTPUT]: :resources（samo_resources.pak + IDR_SAMO_* 常量）、:webui（SamoUI 控制器 + 消息处理器）
# [POS]: Samo 在 Chromium 树里的根（检出后以 src/samo 存在，Brave 式：功能放独立目录，上游只打三处小补丁）
# [PROTOCOL]: 变更时更新此头部，然后检查 CLAUDE.md
import("//tools/grit/grit_rule.gni")
import("//ui/webui/resources/tools/generate_grd.gni")

generate_grd("build_grd") {
  grd_prefix = "samo"
  out_grd = "$target_gen_dir/resources.grd"
  input_files = read_file("//samo/webui/dist/manifest.txt", "list lines")
  input_files_base_dir = rebase_path("//samo/webui/dist", "//")
}

grit("resources") {
  source = "$target_gen_dir/resources.grd"
  enable_input_discovery_for_gn_analyze = false
  deps = [ ":build_grd" ]
  outputs = [
    "grit/samo_resources.h",
    "grit/samo_resources_map.cc",
    "grit/samo_resources_map.h",
    "samo_resources.pak",
  ]
}

source_set("webui") {
  sources = [
    "webui/samo_ui.cc",
    "webui/samo_ui.h",
    "webui/samo_ui_handler.cc",
    "webui/samo_ui_handler.h",
  ]
  deps = [
    ":resources",
    "//base",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/ui/webui:webui_util",
    "//content/public/browser",
    "//ui/webui",  # webui_util
  ]
}
